// Prisma schema file,


generator client {
  provider = "prisma-client-js"
 
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DecisionStatus {
  PROPOSED
  ACCEPTED
  SUPERSEDED
  REVERSED
}
model Decision{
  id              String         @id @default(cuid())
  title           String
  context         String
  options         Json?
  decisionSummary String
  rationale       String
  status          DecisionStatus @default(PROPOSED)
  owner           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  userId          String
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  //one decision can have multiple historical versions
  versions        DecisionVersion[]

  @@index([status])
  @@index([createdAt])
}

model DecisionVersion {
  id                  String         @id @default(cuid())
  decisionId          String
  versionNumber       Int
  title               String
  context             String
  options             Json?
  decisionSummary     String
  rationale           String
  status              DecisionStatus
  owner               String?
  commitMessage       String?
  restoredFromVersion Int?
  createdAt           DateTime       @default(now())

  decision            Decision       @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@unique([decisionId, versionNumber])
  @@index([decisionId])
  @@index([createdAt])
}
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  decisions    Decision[]
}

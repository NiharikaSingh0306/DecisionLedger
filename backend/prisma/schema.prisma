// Prisma schema file,


generator client {
  provider = "prisma-client-js"
 
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DecisionStatus {
  PROPOSED
  ACCEPTED
  SUPERSEDED
  REVERSED
}
model Decision{
  id              String         @id @default(cuid())
  title           String
  context         String
  options         Json?
  decisionSummary String
  rationale       String
  status          DecisionStatus @default(PROPOSED)
  owner           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
}
